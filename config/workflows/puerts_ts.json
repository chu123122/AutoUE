{
  "schema_version": 1,
  "name": "puerts_ts_encounter_flow",
  "description": "Single active PuerTS/TypeScript workflow with EncounterSpec planning and UE API MCP feasibility evidence.",
  "nodes": [
    {
      "name": "SceneAndGameplaySplitter",
      "factory": "custom_nodes.scene_and_gameplay_splitter:create_scene_and_gameplay_splitter",
      "prompt_file": "prompts/scene_and_gameplay_splitter.md",
      "enabled": true,
      "llm_profile": "codex_cli_fast",
      "validator": "scene_and_gameplay_splitter",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        }
      ]
    },
    {
      "name": "EntityAbilityBehaviorPlanner",
      "factory": "custom_nodes.entity_ability_behavior_planner:create_entity_ability_behavior_planner",
      "prompt_file": "prompts/entity_ability_behavior_planner.md",
      "enabled": true,
      "llm_profile": "codex_cli_planning",
      "validator": "entity_ability_behavior_planner",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path": "flow/02-structure.json"
        },
        {
          "kind": "markdown",
          "path": "flow/02-结构化拆解-行为能力实体.md"
        }
      ]
    },
    {
      "name": "ThinGameplayFlowPlanner",
      "factory": "custom_nodes.thin_gameplay_flow_planner:create_thin_gameplay_flow_planner",
      "prompt_file": "prompts/thin_gameplay_flow_planner.md",
      "enabled": true,
      "llm_profile": "codex_cli_planning",
      "validator": "thin_gameplay_flow_planner",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path": "flow/03-thin-gameplay-flow.json"
        }
      ]
    },
    {
      "name": "EncounterSpecPlanner",
      "factory": "custom_nodes.encounter_spec_planner:create_encounter_spec_planner",
      "prompt_file": "prompts/encounter_spec_planner.md",
      "enabled": true,
      "llm_profile": "codex_cli_planning",
      "validator": "encounter_spec_planner",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path": "flow/03-encounter-spec.json"
        },
        {
          "kind": "markdown",
          "path": "flow/03-encounter-spec.md"
        }
      ]
    },
    {
      "name": "UEApiMCPFeasibilitySearcher",
      "factory": "custom_nodes.ue_api_mcp_feasibility_searcher:create_ue_api_mcp_feasibility_searcher",
      "prompt_file": "prompts/ue_api_mcp_feasibility_searcher.md",
      "enabled": true,
      "llm_profile": "codex_cli_fast",
      "validator": "ue_api_mcp_feasibility_searcher",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path_from": "queries[].raw_path"
        },
        {
          "kind": "json",
          "path_from": "queries[].adjudication_path"
        },
        {
          "kind": "json",
          "path": "flow/04-ue-api-mcp/summary.json"
        }
      ]
    },
    {
      "name": "PuerTSRuntimeMappingPlanner",
      "factory": "custom_nodes.puerts_runtime_mapping_planner:create_puerts_runtime_mapping_planner",
      "prompt_file": "prompts/puerts_runtime_mapping_planner.md",
      "enabled": true,
      "llm_profile": "codex_cli_planning",
      "validator": "puerts_runtime_mapping_planner",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path": "flow/05-puerts-runtime-mapping.json"
        }
      ]
    },
    {
      "name": "TypeScriptScriptAnalyzer",
      "factory": "custom_nodes.typescript_script_analyzer:create_typescript_script_analyzer",
      "prompt_file": "prompts/typescript_script_analyzer.md",
      "enabled": true,
      "llm_profile": "codex_cli_planning",
      "validator": "typescript_script_analyzer",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        }
      ]
    },
    {
      "name": "TypeScriptInteractiveObjectGenerator",
      "factory": "custom_nodes.typescript_interactive_object_generator:create_typescript_interactive_object_generator",
      "prompt_file": "prompts/typescript_interactive_object_generator.md",
      "enabled": true,
      "llm_profile": "codex_cli_codegen",
      "validator": "typescript_interactive_object_generator",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "typescript",
          "path_from": "template_inputs[].path"
        }
      ]
    },
    {
      "name": "TypeScriptCodeGenerator",
      "factory": "custom_nodes.typescript_code_generator:create_typescript_code_generator",
      "prompt_file": "prompts/typescript_code_generator.md",
      "enabled": true,
      "llm_profile": "codex_cli_codegen",
      "validator": "typescript_code_generator",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "typescript",
          "path_from": "template_inputs[].path"
        }
      ]
    },
    {
      "name": "EvaluateInstructionGenerator",
      "factory": "custom_nodes.evaluate_instruction_generator:create_evaluate_instruction_generator",
      "prompt_file": "prompts/evaluate_instruction_generator.md",
      "enabled": true,
      "llm_profile": "codex_cli_fast",
      "validator": "evaluate_instruction_generator",
      "output_artifacts": [
        {
          "kind": "llm_output",
          "path": "llm_outputs/{node}.txt"
        },
        {
          "kind": "json",
          "path": "MyPCG/eval/instructions.json"
        }
      ]
    }
  ],
  "validators": [
    "python autoue.py check-config --workflow config/workflows/puerts_ts.json",
    "python autoue.py validate-output --root <output-demo-dir>"
  ],
  "model_partition": {
    "codex_cli_fast": [
      "SceneAndGameplaySplitter",
      "UEApiMCPFeasibilitySearcher",
      "EvaluateInstructionGenerator"
    ],
    "codex_cli_planning": [
      "EntityAbilityBehaviorPlanner",
      "ThinGameplayFlowPlanner",
      "EncounterSpecPlanner",
      "PuerTSRuntimeMappingPlanner",
      "TypeScriptScriptAnalyzer"
    ],
    "codex_cli_codegen": [
      "TypeScriptInteractiveObjectGenerator",
      "TypeScriptCodeGenerator"
    ]
  }
}
