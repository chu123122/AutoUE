import { AutoUESpawnPointRegistry } from './AutoUESpawnPointRegistry';

const LOG_PREFIX = '[AUTOUE_GENERATED]';

export interface {{interface_name}} {
  readonly spawnPointRegistry: AutoUESpawnPointRegistry;
  readonly enemySpawn: any;
  readonly registry: any;
  readonly log?: (message: string) => void;
}

export type AutoUESpawnedEnemy = { enemy_id: string; entity_id: string; actor: any; spawn_group: string; spawn_point_actor?: string; };
export type AutoUEEnemySpawnManager = {
  spawnEncounterEnemies(encounter: any, behaviorSpec: any): AutoUESpawnedEnemy[];
  reset(): void;
  snapshot(): Record<string, unknown>;
};

function log(ctx: {{interface_name}}, message: string): void { (ctx.log || console.warn)(`${LOG_PREFIX} ${message}`); }
function asArray(value: any): any[] { return Array.isArray(value) ? value : []; }
function actorName(actor: any): string { if (!actor) return '<none>'; try { return actor.GetName(); } catch (_) { return String(actor); } }

function enemyComposition(encounter: any): Array<{ enemy: string; count: number }> {
  const raw = asArray(encounter?.composition);
  if (!raw.length) return [];
  return raw.map((item: any) => ({ enemy: String(item?.enemy || ''), count: Math.max(1, Number(item?.count || 1)) })).filter((item) => !!item.enemy);
}

function behaviorForEnemy(behaviorSpec: any, enemyId: string): any | undefined {
  for (const behavior of asArray(behaviorSpec?.behaviors)) {
    if (!behavior || behavior.runtime_domain !== 'enemy_runtime') continue;
    const entityId = String(behavior.bound_entity_id || behavior.entity_id || behavior.primary_entity_id || '');
    if (entityId === enemyId) return behavior;
  }
  for (const behavior of asArray(behaviorSpec?.behaviors)) {
    if (!behavior || behavior.runtime_domain !== 'enemy_runtime') continue;
    const hasSpawn = asArray(behavior.resolved_capabilities).some((cap: any) => cap?.handler === 'EnemySpawnRuntime.spawnEnemy');
    if (hasSpawn) return behavior;
  }
  return undefined;
}

function enemyTags(behavior: any, enemyId: string): string[] {
  const out = [enemyId];
  for (const capability of asArray(behavior?.resolved_capabilities)) {
    const params = capability?.params || {};
    if (params.enemy_tag) out.push(String(params.enemy_tag));
    if (Array.isArray(params.enemy_tags)) for (const tag of params.enemy_tags) out.push(String(tag));
  }
  const lowered = enemyId.toLowerCase();
  if (lowered.indexOf('zombie') >= 0 || lowered.indexOf('melee') >= 0) out.push('ground', 'melee');
  if (lowered.indexOf('archer') >= 0 || lowered.indexOf('ranged') >= 0) out.push('ground', 'ranged');
  return Array.from(new Set(out.filter(Boolean)));
}

export function {{export_name}}(context: {{interface_name}}): AutoUEEnemySpawnManager {
  const spawned: AutoUESpawnedEnemy[] = [];
  return {
    spawnEncounterEnemies(encounter: any, behaviorSpec: any): AutoUESpawnedEnemy[] {
      const spawnGroup = String(encounter?.spawn_group || '');
      if (!spawnGroup) { log(context, `EnemySpawnManagerRejected encounter=${encounter?.encounter_id || '<unknown>'} reason=missing_spawn_group`); return []; }
      const consume = encounter?.spawn_policy?.consume_spawn_point !== false;
      const created: AutoUESpawnedEnemy[] = [];
      for (const item of enemyComposition(encounter)) {
        const behavior = behaviorForEnemy(behaviorSpec, item.enemy);
        if (!behavior) { log(context, `EnemySpawnManagerRejected enemy=${item.enemy} reason=no_behavior_mapping`); continue; }
        const tags = enemyTags(behavior, item.enemy);
        for (let i = 0; i < item.count; i++) {
          const point = context.spawnPointRegistry.acquireSpawnPoint(spawnGroup, tags, consume);
          if (!point) { log(context, `EnemySpawnManagerRejected enemy=${item.enemy} spawn_group=${spawnGroup} reason=no_spawn_point`); continue; }
          const actor = context.enemySpawn.spawnEnemy(behavior, point.transform);
          const records = context.registry.all?.() || [];
          const record = records.length ? records[records.length - 1] : undefined;
          const handle = { enemy_id: String(record?.enemy_id || actorName(actor)), entity_id: String(record?.entity_id || item.enemy), actor, spawn_group: spawnGroup, spawn_point_actor: point.actor_name };
          spawned.push(handle);
          created.push(handle);
          const loc = point.transform.location;
          log(context, `EnemySpawnedByEncounter encounter=${encounter?.encounter_id || '<unknown>'} enemy=${item.enemy} enemy_id=${handle.enemy_id} spawn_group=${spawnGroup} spawn_point=${point.actor_name} loc=${Math.round(loc.X)},${Math.round(loc.Y)},${Math.round(loc.Z)}`);
        }
      }
      return created;
    },
    reset(): void { spawned.length = 0; },
    snapshot(): Record<string, unknown> { return { schema_version: 'autoue-enemy-spawn-manager/v3', spawned_count: spawned.length, spawned }; }
  };
}
