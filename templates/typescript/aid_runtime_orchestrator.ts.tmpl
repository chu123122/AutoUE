type GeneratedState = { elapsed: number; cameraShakeUntil: number; exitReached: boolean; roomComplete: boolean; trapArmed: boolean; trapTriggerCount: number; };
type RuntimeServices = { worldAdapter?: any; enemyRegistry?: any; spawnPointRegistry?: any; enemySpawn?: any; enemySpawnManager?: any; enemyPerception?: any; enemyMovement?: any; enemyCombat?: any; enemyPresentation?: any; enemyHealth?: any; enemyDeathEvents?: any; enemyDispatcher?: any; enemyBrain?: any; encounterManager?: any; playerCombat?: any; };
export interface {{interface_name}} { readonly spec?: any; readonly router?: any; readonly conditions?: any; readonly dispatcher?: any; readonly log?: (message: string) => void; }
function log(message: string): void { console.warn(`${LOG_PREFIX} ${message}`); }
function moduleLog(message: string): void { console.warn(String(message).indexOf(LOG_PREFIX) >= 0 ? String(message) : `${LOG_PREFIX} ${message}`); }
function runtimeFeature(name: string): boolean { return RUNTIME_FEATURES.indexOf(name) >= 0 && DISABLED_FEATURES.indexOf(name) < 0; }
function generatedFactory(modulePath: string, exportName: string): any | undefined { try { const mod = require(modulePath); return mod ? mod[exportName] : undefined; } catch (e) { log(`RuntimeModuleUnavailable module=${modulePath} export=${exportName} error=${e}`); return undefined; } }
function loc(actor: UE.Actor): UE.Vector { try { return actor.K2_GetActorLocation(); } catch (_) { return new UE.Vector(0, ROOM_Y, FLOOR_Z); } }
function dist(a: UE.Actor, b: UE.Actor): number { try { return a.GetDistanceTo(b); } catch (_) { const al = loc(a); const bl = loc(b); const dx = al.X - bl.X; const dy = al.Y - bl.Y; const dz = al.Z - bl.Z; return Math.sqrt(dx * dx + dy * dy + dz * dz); } }
function addTag(actor: UE.Actor, tag: string): void { try { actor.Tags.Add(tag); } catch (_) {} }
function clearTags(actor: UE.Actor): void { try { (actor.Tags as any).Empty(); } catch (_) {} }
function makeMaterial(owner: UE.Object, r: number, g: number, b: number): UE.MaterialInstanceDynamic | undefined { try { const base = UE.Material.Load('/Engine/BasicShapes/BasicShapeMaterial'); if (!base) return undefined; const mat = UE.KismetMaterialLibrary.CreateDynamicMaterialInstance(owner, base); mat.SetVectorParameterValue('Color', new UE.LinearColor(r, g, b, 1)); return mat; } catch (_) { return undefined; } }
function makeWorldMesh(owner: UE.Character, name: string, world: UE.Vector, scale: UE.Vector, color: UE.LinearColor): UE.StaticMeshComponent | undefined { try { const c = new UE.StaticMeshComponent(owner, name); const mesh = UE.StaticMesh.Load('/Engine/BasicShapes/Cube'); if (mesh) c.SetStaticMesh(mesh); c.SetRelativeScale3D(scale); const mat = makeMaterial(owner, color.R, color.G, color.B); if (mat) c.SetMaterial(0, mat); const blocksPawn = name.indexOf('RoomFloor') >= 0 || name.indexOf('Platform') >= 0; c.SetCollisionEnabled(blocksPawn ? UE.ECollisionEnabled.QueryAndPhysics : UE.ECollisionEnabled.QueryOnly); try { if (blocksPawn) c.SetCollisionProfileName('BlockAll'); } catch (_) {} c.SetAbsolute(true, false, false); c.RegisterComponent(); (c as any).K2_SetWorldLocation(world, false, undefined, true); try { c.ComponentTags.Add(name); } catch (_) {} return c; } catch (e) { log(`WorldMeshCreateFailed name=${name} error=${e}`); return undefined; } }
function ensurePlayerVisual(actor: UE.Character): void { const self = actor as any; if (self._autoueGeneratedPlayerVisual) return; try { const c = new UE.StaticMeshComponent(actor, 'AutoUEGenerated_PlayerVisual'); const mesh = UE.StaticMesh.Load('/Engine/BasicShapes/Cube'); if (mesh) c.SetStaticMesh(mesh); c.SetRelativeScale3D(new UE.Vector(0.85, 0.85, 1.35)); const mat = makeMaterial(actor, 1.0, 0.55, 0.05); if (mat) c.SetMaterial(0, mat); c.SetupAttachment(actor.RootComponent, ''); c.SetCollisionEnabled(UE.ECollisionEnabled.NoCollision); c.RegisterComponent(); (c as any).K2_SetRelativeLocation(new UE.Vector(0, 0, 0), false, undefined, true); try { c.ComponentTags.Add('AUTOUE_GENERATED_PLAYER_VISUAL'); } catch (_) {} self._autoueGeneratedPlayerVisual = c; log('PlayerVisualReady=1'); } catch (e) { log(`PlayerVisualCreateFailed error=${e}`); } }
function ensureSceneLight(actor: UE.Character): void { const self = actor as any; if (self._autoueGeneratedKeyLight) return; try { const light = new UE.PointLightComponent(actor, 'AutoUEGenerated_KeyLight'); light.Intensity = 9000; light.AttenuationRadius = 3200; try { light.LightColor = new UE.Color(255, 244, 220, 255); } catch (_) {} light.SetAbsolute(true, false, false); light.RegisterComponent(); (light as any).K2_SetWorldLocation(new UE.Vector(EXIT_X * 0.5, ROOM_Y - 220, FLOOR_Z + 650), false, undefined, true); try { light.ComponentTags.Add('AUTOUE_GENERATED_KEY_LIGHT'); } catch (_) {} self._autoueGeneratedKeyLight = light; log('SceneLightReady=1'); } catch (e) { log(`SceneLightCreateFailed error=${e}`); } }

function initialState(): GeneratedState { return { elapsed: 0, cameraShakeUntil: 0, exitReached: false, roomComplete: false, trapArmed: true, trapTriggerCount: 0 }; }
function inputRuntime(actor: UE.Character): AutoUEInputHarnessRuntime { const self = actor as any; if (!self._autoueInputRuntime) self._autoueInputRuntime = createAutoUEInputHarnessRuntime({}); return self._autoueInputRuntime; }
function movementRuntime(actor: UE.Character): AutoUEMovementRuntime { const self = actor as any; if (!self._autoueMovementRuntime) self._autoueMovementRuntime = createAutoUEMovementRuntime({}); return self._autoueMovementRuntime; }
function trapRuntime(actor: UE.Character): AutoUETrapRuntime { const self = actor as any; if (!self._autoueTrapRuntime) self._autoueTrapRuntime = createAutoUETrapRuntime({}); return self._autoueTrapRuntime; }
function vfxRuntime(actor: UE.Character): AutoUEVfxRuntime { const self = actor as any; if (!self._autoueVfxRuntime) self._autoueVfxRuntime = createAutoUEVfxRuntime({}); return self._autoueVfxRuntime; }
function stateBlackboard(actor: UE.Character): AutoUEStateBlackboard { const self = actor as any; if (!self._autoueStateBlackboard) self._autoueStateBlackboard = createAutoUEStateBlackboard({ nowSeconds: () => ((self._autoueGeneratedState || { elapsed: 0 }) as GeneratedState).elapsed }); return self._autoueStateBlackboard; }
function runtimeServices(actor: UE.Character): RuntimeServices {
  const self = actor as any;
  if (self._autoueGeneratedServices) return self._autoueGeneratedServices as RuntimeServices;
  const services: RuntimeServices = {};
  const worldAdapterFactory = generatedFactory('./AutoUEWorldAdapter', 'createAutoUEWorldAdapter');
  if (worldAdapterFactory) services.worldAdapter = worldAdapterFactory({ UE, actor, world: actor, entities: { player: actor, prisoner: actor }, log: moduleLog });
  if (runtimeFeature('enemy_runtime')) {
    const registryFactory = generatedFactory('./AutoUEEnemyRegistry', 'createAutoUEEnemyRegistry');
    const spawnPointFactory = generatedFactory('./AutoUESpawnPointRegistry', 'createAutoUESpawnPointRegistry');
    const spawnFactory = generatedFactory('./AutoUEEnemySpawnRuntime', 'createAutoUEEnemySpawnRuntime');
    const spawnManagerFactory = generatedFactory('./AutoUEEnemySpawnManager', 'createAutoUEEnemySpawnManager');
    const perceptionFactory = generatedFactory('./AutoUEEnemyPerception', 'createAutoUEEnemyPerception');
    const movementFactory = generatedFactory('./AutoUEEnemyMovement', 'createAutoUEEnemyMovement');
    const combatFactory = generatedFactory('./AutoUEEnemyCombat', 'createAutoUEEnemyCombat');
    const presentationFactory = generatedFactory('./AutoUEEnemyPresentationRuntime', 'createAutoUEEnemyPresentationRuntime');
    const healthFactory = generatedFactory('./AutoUEEnemyHealth', 'createAutoUEEnemyHealth');
    const deathFactory = generatedFactory('./AutoUEEnemyDeathEvents', 'createAutoUEEnemyDeathEvents');
    const dispatcherFactory = generatedFactory('./AutoUEEnemyAbilityDispatcher', 'createAutoUEEnemyAbilityDispatcher');
    const brainFactory = generatedFactory('./AutoUEEnemyBrain', 'createAutoUEEnemyBrain');
    const encounterFactory = generatedFactory('./AutoUEEncounterManager', 'createAutoUEEncounterManager');
    if (registryFactory) services.enemyRegistry = registryFactory({ log: moduleLog });
    if (services.worldAdapter && spawnPointFactory) services.spawnPointRegistry = spawnPointFactory({ worldContext: actor, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && spawnFactory) services.enemySpawn = spawnFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, spec: BEHAVIOR_SPEC, log: moduleLog });
    if (services.enemyRegistry && services.spawnPointRegistry && services.enemySpawn && spawnManagerFactory) services.enemySpawnManager = spawnManagerFactory({ spawnPointRegistry: services.spawnPointRegistry, enemySpawn: services.enemySpawn, registry: services.enemyRegistry, log: moduleLog });
    if (services.enemyRegistry && services.enemySpawnManager && encounterFactory) services.encounterManager = encounterFactory({ registry: services.enemyRegistry, spawnManager: services.enemySpawnManager, log: moduleLog });
    if (services.worldAdapter && presentationFactory) services.enemyPresentation = presentationFactory({ worldAdapter: services.worldAdapter, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && deathFactory) services.enemyDeathEvents = deathFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, encounterManager: services.encounterManager, presentation: services.enemyPresentation, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && healthFactory) services.enemyHealth = healthFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, deathEvents: services.enemyDeathEvents, presentation: services.enemyPresentation, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && combatFactory) services.enemyCombat = combatFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, deathEvents: services.enemyDeathEvents, health: services.enemyHealth, presentation: services.enemyPresentation, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && perceptionFactory) services.enemyPerception = perceptionFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, log: moduleLog });
    if (services.worldAdapter && services.enemyRegistry && movementFactory) services.enemyMovement = movementFactory({ worldAdapter: services.worldAdapter, registry: services.enemyRegistry, log: moduleLog });
    if (dispatcherFactory) services.enemyDispatcher = dispatcherFactory({ spawnRuntime: services.enemySpawn, perception: services.enemyPerception, movement: services.enemyMovement, combat: services.enemyCombat, health: services.enemyHealth, deathEvents: services.enemyDeathEvents, encounterManager: services.encounterManager, log: moduleLog });
    if (brainFactory && services.enemyRegistry && services.worldAdapter && services.enemyPerception && services.enemyMovement && services.enemyCombat && services.enemyDispatcher) services.enemyBrain = brainFactory({ registry: services.enemyRegistry, worldAdapter: services.worldAdapter, perception: services.enemyPerception, movement: services.enemyMovement, combat: services.enemyCombat, dispatcher: services.enemyDispatcher, log: moduleLog });
  }
  if (runtimeFeature('player_combat_runtime')) {
