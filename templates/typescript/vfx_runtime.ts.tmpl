const LOG_PREFIX = '[AUTOUE_GENERATED]';
function log(message: string): void { console.warn(`${LOG_PREFIX} ${message}`); }
function makeMaterial(owner: UE.Object, r: number, g: number, b: number): UE.MaterialInstanceDynamic | undefined {
  try { const base = UE.Material.Load('/Engine/BasicShapes/BasicShapeMaterial'); if (!base) return undefined; const mat = UE.KismetMaterialLibrary.CreateDynamicMaterialInstance(owner, base); mat.SetVectorParameterValue('Color', new UE.LinearColor(r, g, b, 1)); return mat; } catch (_) { return undefined; }
}
function makeAttachedMesh(owner: UE.Character): UE.StaticMeshComponent | undefined {
  try {
    const c = new UE.StaticMeshComponent(owner, 'AutoUEGenerated_FreezeVFX');
    const mesh = UE.StaticMesh.Load('/Engine/BasicShapes/Cube');
    if (mesh) c.SetStaticMesh(mesh);
    c.SetRelativeScale3D(new UE.Vector(1.4, 1.4, 1.4));
    const mat = makeMaterial(owner, 0.25, 0.9, 1);
    if (mat) c.SetMaterial(0, mat);
    c.SetupAttachment(owner.RootComponent, '');
    c.RegisterComponent();
    (c as any).K2_SetRelativeLocation(new UE.Vector(0, 0, 80), false, undefined, true);
    c.SetVisibility(false, true);
    try { c.ComponentTags.Add('AUTOUE_GENERATED_FREEZE_VFX'); } catch (_) {}
    log('FreezeVFXReady=1');
    return c;
  } catch (e) { log(`FreezeVFXCreateFailed error=${e}`); return undefined; }
}

