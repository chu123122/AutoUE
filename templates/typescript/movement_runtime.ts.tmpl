import UE = require('ue');
import { AutoUEHarnessInput } from './AutoUEInputHarnessRuntime';

export interface {{interface_name}} { runId?: string; }
export type AutoUEMovementRuntime = { tick(actor: UE.Character, dt: number, elapsed: number, input: AutoUEHarnessInput, frozen: boolean): boolean; snapshot(actor: UE.Actor): Record<string, unknown>; };

const MOVE_SPEED = 620;
const DASH_SPEED = 1100;
const ACCEL_RESPONSE = 13.5;
const DECEL_RESPONSE = 18.0;
const MIN_MOVE_SPEED = 8;
const LOG_PREFIX = '[AUTOUE_GENERATED]';
function log(message: string): void { console.warn(`${LOG_PREFIX} ${message}`); }
function loc(actor: UE.Actor): UE.Vector { try { return actor.K2_GetActorLocation(); } catch (_) { return new UE.Vector(0, 0, 92); } }

export function {{export_name}}(_context: {{interface_name}} = {}): AutoUEMovementRuntime {
  let velocityX = 0;
  return {
    tick(actor: UE.Character, dt: number, elapsed: number, input: AutoUEHarnessInput, frozen: boolean): boolean {
      const axis = elapsed <= input.axisUntil ? input.axis : 0;
      if (frozen) { if (Math.abs(velocityX) > MIN_MOVE_SPEED) log('MoveBlocked reason=frozen'); velocityX = 0; return false; }
      const dash = elapsed <= input.dashUntil;
      const maxSpeed = dash ? DASH_SPEED : MOVE_SPEED;
      const targetVelocity = axis * maxSpeed;
      const response = axis ? ACCEL_RESPONSE : DECEL_RESPONSE;
      const blend = 1 - Math.exp(-Math.max(0, dt) * response);
      velocityX += (targetVelocity - velocityX) * blend;
      if (!axis && Math.abs(velocityX) < MIN_MOVE_SPEED) { velocityX = 0; return false; }
      if (Math.abs(velocityX) < MIN_MOVE_SPEED) return false;
      try { (actor as any).K2_AddActorWorldOffset(new UE.Vector(velocityX * dt, 0, 0), true, undefined, true); } catch (e) { log(`MoveFailed error=${e}`); return false; }
      log(`MoveInput axis=${axis} dash=${dash ? 1 : 0} vx=${Math.round(velocityX)} x=${Math.round(loc(actor).X)}`);
      return true;
    },
    snapshot(actor: UE.Actor): Record<string, unknown> { return { schema_version: 'autoue-movement-runtime/v1', pawnX: loc(actor).X, velocityX }; },
  };
}
