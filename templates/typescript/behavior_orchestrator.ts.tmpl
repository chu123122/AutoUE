import UE = require('ue');
import { getAutoUEBehaviorSpec } from './AutoUEBehaviorSpec.generated';
import { setupAutoUEGeneratedCamera, updateAutoUEGeneratedSideCamera } from './AutoUEGeneratedCameraHelper';
import { getAutoUEGeneratedSceneManifest } from './AutoUEGeneratedSceneManifest';
import { createAutoUEInputHarnessRuntime, AutoUEInputHarnessRuntime } from './AutoUEInputHarnessRuntime';
import { createAutoUEMovementRuntime, AutoUEMovementRuntime } from './AutoUEMovementRuntime';
import { createAutoUETrapRuntime, AutoUETrapRuntime } from './AutoUETrapRuntime';
import { createAutoUEStateBlackboard, AutoUEStateBlackboard } from './AutoUEStateBlackboard';
import { createAutoUEVfxRuntime, AutoUEVfxRuntime } from './AutoUEVfxRuntime';

const LOG_PREFIX = '[AUTOUE_GENERATED]';
const ROOM_Y = 0;
const FLOOR_Z = 92;
const EXIT_X = 820;
const EXIT_RADIUS = 165;
const FREEZE_STATE_KEY = 'player.effects.frozen';
const FREEZE_SECONDS = 1.25;
const CAMERA_SHAKE_SECONDS = 0.35;
const BEHAVIOR_ID = {{behavior_id_json}};
const RUNTIME_FEATURES = {{runtime_features_json}} as string[];
const DISABLED_FEATURES = {{disabled_features_json}} as string[];
const BEHAVIOR_SPEC = {{behavior_spec_json}};

type GeneratedState = { elapsed: number; cameraShakeUntil: number; exitReached: boolean; roomComplete: boolean; trapArmed: boolean; trapTriggerCount: number; };
export interface {{interface_name}} { readonly spec?: any; readonly router?: any; readonly conditions?: any; readonly dispatcher?: any; readonly log?: (message: string) => void; }
function log(message: string): void { console.warn(`${LOG_PREFIX} ${message}`); }
function loc(actor: UE.Actor): UE.Vector { try { return actor.K2_GetActorLocation(); } catch (_) { return new UE.Vector(0, ROOM_Y, FLOOR_Z); } }
function addTag(actor: UE.Actor, tag: string): void { try { actor.Tags.Add(tag); } catch (_) {} }
function clearTags(actor: UE.Actor): void { try { (actor.Tags as any).Empty(); } catch (_) {} }
function makeMaterial(owner: UE.Object, r: number, g: number, b: number): UE.MaterialInstanceDynamic | undefined { try { const base = UE.Material.Load('/Engine/BasicShapes/BasicShapeMaterial'); if (!base) return undefined; const mat = UE.KismetMaterialLibrary.CreateDynamicMaterialInstance(owner, base); mat.SetVectorParameterValue('Color', new UE.LinearColor(r, g, b, 1)); return mat; } catch (_) { return undefined; } }
function makeWorldMesh(owner: UE.Character, name: string, world: UE.Vector, scale: UE.Vector, color: UE.LinearColor): UE.StaticMeshComponent | undefined { try { const c = new UE.StaticMeshComponent(owner, name); const mesh = UE.StaticMesh.Load('/Engine/BasicShapes/Cube'); if (mesh) c.SetStaticMesh(mesh); c.SetRelativeScale3D(scale); const mat = makeMaterial(owner, color.R, color.G, color.B); if (mat) c.SetMaterial(0, mat); c.SetCollisionEnabled(UE.ECollisionEnabled.QueryOnly); c.SetAbsolute(true, false, false); c.RegisterComponent(); (c as any).K2_SetWorldLocation(world, false, undefined, true); try { c.ComponentTags.Add(name); } catch (_) {} return c; } catch (e) { log(`WorldMeshCreateFailed name=${name} error=${e}`); return undefined; } }

function initialState(): GeneratedState { return { elapsed: 0, cameraShakeUntil: 0, exitReached: false, roomComplete: false, trapArmed: true, trapTriggerCount: 0 }; }
function inputRuntime(actor: UE.Character): AutoUEInputHarnessRuntime { const self = actor as any; if (!self._autoueInputRuntime) self._autoueInputRuntime = createAutoUEInputHarnessRuntime({}); return self._autoueInputRuntime; }
function movementRuntime(actor: UE.Character): AutoUEMovementRuntime { const self = actor as any; if (!self._autoueMovementRuntime) self._autoueMovementRuntime = createAutoUEMovementRuntime({}); return self._autoueMovementRuntime; }
function trapRuntime(actor: UE.Character): AutoUETrapRuntime { const self = actor as any; if (!self._autoueTrapRuntime) self._autoueTrapRuntime = createAutoUETrapRuntime({}); return self._autoueTrapRuntime; }
function vfxRuntime(actor: UE.Character): AutoUEVfxRuntime { const self = actor as any; if (!self._autoueVfxRuntime) self._autoueVfxRuntime = createAutoUEVfxRuntime({}); return self._autoueVfxRuntime; }
function stateBlackboard(actor: UE.Character): AutoUEStateBlackboard { const self = actor as any; if (!self._autoueStateBlackboard) self._autoueStateBlackboard = createAutoUEStateBlackboard({ nowSeconds: () => ((self._autoueGeneratedState || { elapsed: 0 }) as GeneratedState).elapsed }); return self._autoueStateBlackboard; }
function isFrozen(actor: UE.Character): boolean { return stateBlackboard(actor).isActive(FREEZE_STATE_KEY); }
function writeFreezeState(actor: UE.Character): void { stateBlackboard(actor).set(FREEZE_STATE_KEY, { active: true, duration: FREEZE_SECONDS }, FREEZE_SECONDS); log('StateWritten player.effects.frozen duration=' + FREEZE_SECONDS); }

function refreshTags(actor: UE.Actor, state: GeneratedState, frozen: boolean): void {
  clearTags(actor);
  addTag(actor, 'Player');
  addTag(actor, 'AUTOUE_GENERATED_ACTIVE');
  addTag(actor, 'AUTOUE_FEATURES_' + RUNTIME_FEATURES.join('_'));
  if (DISABLED_FEATURES.indexOf('enemy_encounter') >= 0) addTag(actor, 'AUTOUE_ENEMY_ENCOUNTER_DISABLED');
  if (frozen) addTag(actor, 'AUTOUE_GENERATED_PLAYER_FROZEN');
  if (!state.trapArmed) addTag(actor, 'AUTOUE_GENERATED_TRAP_SPENT');
  if (state.roomComplete) addTag(actor, 'AUTOUE_GENERATED_ROOM_COMPLETE');
}

export class AutoUEBehaviorOrchestrator {
  private readonly behaviorById = new Map<string, any>();
  constructor(private readonly context: {{interface_name}} = {}) { for (const behavior of ((context.spec || BEHAVIOR_SPEC)?.behaviors || [])) this.behaviorById.set(behavior.behavior_id, behavior); }
  start(): void { for (const behavior of this.behaviorById.values()) { this.context.dispatcher?.validate?.(behavior.actions || []); this.context.router?.bindBehavior?.(behavior); } }
  runBehavior(behaviorId: string, payload?: unknown): void { const behavior = this.behaviorById.get(behaviorId); if (!behavior) throw new Error(`Unknown AutoUE behavior: ${behaviorId}`); if (!this.context.conditions?.all?.(behavior.conditions || [])) return; this.context.log?.(`BehaviorTriggered ${behaviorId}`); for (const action of behavior.actions || []) this.context.dispatcher?.dispatch?.(action, payload); for (const line of behavior.verification_logs || []) this.context.log?.(line); }
}
export function {{export_name}}(context?: {{interface_name}}): AutoUEBehaviorOrchestrator { return new AutoUEBehaviorOrchestrator(context); }

export function configureAutoUEGeneratedCharacter(actor: UE.Character): void {
  actor.PrimaryActorTick.bCanEverTick = true;
  actor.PrimaryActorTick.bStartWithTickEnabled = true;
  try { actor.CharacterMovement.MaxWalkSpeed = 620; } catch (_) {}
  try { (actor.CharacterMovement as any).bRunPhysicsWithNoController = true; } catch (_) {}
  try { (actor.CharacterMovement as any).bConstrainToPlane = true; } catch (_) {}
  try { (actor.CharacterMovement as any).SetPlaneConstraintNormal(new UE.Vector(0, 1, 0)); } catch (_) {}
  try { actor.CapsuleComponent.SetCapsuleSize(48, 96, true); } catch (_) {}
}

function resetGeneratedRuntime(actor: UE.Character): void {
  const self = actor as any;
  self._autoueGeneratedState = initialState();
  self._autoueStateBlackboard = createAutoUEStateBlackboard({ nowSeconds: () => ((self._autoueGeneratedState || { elapsed: 0 }) as GeneratedState).elapsed });
  inputRuntime(actor).reset();
  trapRuntime(actor).reset();
  vfxRuntime(actor).reset(actor);
  try { (actor as any).K2_SetActorLocation(new UE.Vector(0, ROOM_Y, FLOOR_Z + 40), false, undefined, true); } catch (_) {}
  refreshTags(actor, self._autoueGeneratedState as GeneratedState, false);
  log('RuntimeReset=1 EnemyEncounterEnabled=0');
}

export function beginAutoUEGeneratedCharacter(actor: UE.Character): void {
  const self = actor as any;
  configureAutoUEGeneratedCharacter(actor);
  if (!self._autoueGeneratedFloor) self._autoueGeneratedFloor = makeWorldMesh(actor, 'AutoUEGenerated_RoomFloor', new UE.Vector(EXIT_X * 0.5, ROOM_Y, 25), new UE.Vector(10, 2.0, 0.08), new UE.LinearColor(0.18, 0.18, 0.18, 1));
  if (!self._autoueGeneratedTrap) self._autoueGeneratedTrap = makeWorldMesh(actor, 'AutoUEGenerated_IceTrap', new UE.Vector(160, ROOM_Y, FLOOR_Z), new UE.Vector(0.65, 0.65, 0.2), new UE.LinearColor(0.2, 0.8, 1, 1));
  if (!self._autoueGeneratedExit) self._autoueGeneratedExit = makeWorldMesh(actor, 'AutoUEGenerated_Exit', new UE.Vector(EXIT_X, ROOM_Y, FLOOR_Z), new UE.Vector(0.35, 1.0, 1.65), new UE.LinearColor(0.05, 0.9, 0.15, 1));
  vfxRuntime(actor).ensure(actor);
  setupAutoUEGeneratedCamera(actor, { orthoWidth: 1450, armLength: 1650 });
  resetGeneratedRuntime(actor);
  const manifest = getAutoUEGeneratedSceneManifest({});
  const spec = getAutoUEBehaviorSpec({});
  log(`BeginPlay behavior=${BEHAVIOR_ID} specBehaviors=${(spec.behaviors as unknown[]).length} features=${RUNTIME_FEATURES.join(',')} disabled=${DISABLED_FEATURES.join(',')} manifestActors=${(manifest.actors as unknown[]).length}`);
  log('HarnessReady tags=AUTOUE_INPUT_RIGHT,AUTOUE_INPUT_RIGHT_1S,AUTOUE_INPUT_RIGHT_3S,AUTOUE_INPUT_LEFT,AUTOUE_INPUT_DASH,AUTOUE_INPUT_ATTACK,AUTOUE_INPUT_RESET');
}

function updateExit(actor: UE.Character, state: GeneratedState, frozen: boolean): void {
  if (state.roomComplete || frozen) return;
  const distance = Math.abs(loc(actor).X - EXIT_X);
  if (distance <= EXIT_RADIUS) { state.exitReached = true; state.roomComplete = true; stateBlackboard(actor).set('exit.level_exit_door.unlocked', true); log(`ExitReached=1 RoomComplete=1 distance=${Math.round(distance)}`); }
}

export function tickAutoUEGeneratedCharacter(actor: UE.Character, dt: number): void {
  const self = actor as any;
  if (!self._autoueGeneratedState) beginAutoUEGeneratedCharacter(actor);
  const state = self._autoueGeneratedState as GeneratedState;
  state.elapsed += dt;
  stateBlackboard(actor).clearExpired();
  const pc = UE.GameplayStatics.GetPlayerController(actor, 0);
  const input = inputRuntime(actor).read(actor, pc, state.elapsed);
  if (input.resetRequested) resetGeneratedRuntime(actor);
  const frozenBefore = isFrozen(actor);
  const moved = movementRuntime(actor).tick(actor, dt, state.elapsed, input, frozenBefore);
  const trap = trapRuntime(actor).tick(actor, state.elapsed, frozenBefore);
  state.trapArmed = trap.trapArmed;
  state.trapTriggerCount = trap.triggerCount;
  if (trap.triggered) { writeFreezeState(actor); state.cameraShakeUntil = state.elapsed + CAMERA_SHAKE_SECONDS; log('CameraShakeTriggered=1'); }
  const frozenNow = isFrozen(actor);
  vfxRuntime(actor).setFrozenVisible(actor, frozenNow);
  try { const shake = state.elapsed < state.cameraShakeUntil ? Math.sin(state.elapsed * 95) * 18 : 0; updateAutoUEGeneratedSideCamera(actor, shake); } catch (_) {}
  updateExit(actor, state, frozenNow);
  refreshTags(actor, state, frozenNow);
  if (moved || trap.triggered || trap.rearmed) log(`BehaviorTick behavior=${BEHAVIOR_ID} frozen=${frozenNow ? 1 : 0} trapArmed=${state.trapArmed ? 1 : 0}`);
}

export function latestAutoUEGeneratedSnapshot(actor: UE.Actor): Record<string, unknown> | undefined {
  const self = actor as any;
  const state = self._autoueGeneratedState as GeneratedState | undefined;
  if (!state) return undefined;
  const character = actor as UE.Character;
  return { ...state, pawnX: loc(actor).X, exitX: EXIT_X, frozen: isFrozen(character), state_blackboard: stateBlackboard(character).snapshot(), input: inputRuntime(character).snapshot(), movement: movementRuntime(character).snapshot(actor), trap: trapRuntime(character).snapshot(actor), vfx: vfxRuntime(character).snapshot(character), cameraShakeActive: state.elapsed < state.cameraShakeUntil, runtime_features: RUNTIME_FEATURES, disabled_features: DISABLED_FEATURES };
}

