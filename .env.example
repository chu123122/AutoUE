# AutoUE local runtime switches. Copy to .env for local use; do not commit .env.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoue-local

AUTOUE_CONFIG=
AUTOUE_WORKFLOW=
AUTOUE_TS_OUTPUT_DIR=

# Optional OpenAI-compatible local service profile.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=local-model

# Codex CLI provider. Leave model vars empty to use the current Codex config default.
CODEX_CLI_PATH=
CODEX_FAST_MODEL=gpt-5.5
CODEX_PLANNING_MODEL=gpt-5.5
CODEX_CODEGEN_MODEL=gpt-5.5
CODEX_AGENT_TIMEOUT_SEC=1200

# Optional UE API MCP stdio override. If empty, AutoUE falls back to ~/.codex/config.toml.
AUTOUE_UE_API_MCP_COMMAND=
AUTOUE_UE_API_MCP_ARGS=
AUTOUE_UE_API_MCP_ENV_JSON=
AUTOUE_UE_API_MCP_TIMEOUT_SEC=
